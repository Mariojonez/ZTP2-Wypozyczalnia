{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.reservation_list'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.reservation_list'|trans }}</h1>

    {% if pagination is defined and pagination.items|length %}

        <div class="navigation text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

        <table class="table">
            <thead>
            <tr>
                <th>{{ 'label.user'|trans }}</th>
                <th>{{ 'label.title'|trans }}</th>
                <th>{{ 'label.status'|trans }}</th>
                <th>{{ 'label.comment'|trans }}</th>
                <th>{{ 'label.actions'|trans }}</th>
            </tr>
            </thead>
            <tbody>
            {% for reservation in pagination.items %}
                <tr>
                    <td>{{ reservation.user.email }}</td>
                    <td>{{ reservation.task.title }}</td>
                    <td>{{ reservation.status|trans }}</td>
                    <td>{{ reservation.comment }}</td>
                    <td>
                        {% if is_granted('CHANGE_STATUS', reservation) %}
                            <a
                                class="btn btn-primary btn-sm"
                                href="{{ path('reservation_change_status', {id: reservation.id}) }}"
                                title="{{ 'action.change_status'|trans }}"
                            >
                                {{ 'action.change_status'|trans }}
                            </a>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="navigation text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <p>
            {{ 'message.empty_list'|trans }}
        </p>
    {% endif %}

    <a
        href="{{ path('book_index') }}"
        title="{{ 'action.book_list'|trans }}"
    >
        {{ 'action.book_list'|trans }}
    </a>
{% endblock %}
