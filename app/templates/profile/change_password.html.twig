{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.change_password'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.change_password'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.currentPassword) }}
    {{ form_row(form.newPassword.first) }}
    {{ form_row(form.newPassword.second) }}

    <button class="btn btn-primary">{{ 'title.change_password'|trans }}</button>
    {{ form_end(form) }}

    <a href="{{ url('book_index') }}" title="{{ 'action.task_list'|trans }}">
        {{ 'action.task_list'|trans }}
    </a>
{% endblock %}
