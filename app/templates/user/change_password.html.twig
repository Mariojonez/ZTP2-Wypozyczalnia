{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.change_password'|trans }}
{% endblock %}

{% block body %}
    <h1>{{ 'title.change_password'|trans }}</h1>

    <p>
        {{ user.email }}
    </p>

    {{ form_start(form) }}
    {{ form_widget(form) }}

    <button class="btn btn-primary">
        {{ 'action.save'|trans }}
    </button>

    <a href="{{ path('user_index') }}"
       class="btn btn-secondary">
        {{ 'action.cancel'|trans }}
    </a>
    {{ form_end(form) }}

{% endblock %}
